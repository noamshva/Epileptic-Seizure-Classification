.venv3_11/
venv3_11/
.venv/
venv/
env/

# =========================================================
# Python cache files
# =========================================================
__pycache__/
src/__pycache__/
src/*/__pycache__/
*.pyc
*.pyo

# =========================================================
# Dataset directories (keep only structure + READMEs)
# =========================================================
dataset/chbmit/*
dataset/spikes_raw/*
dataset/spikes_windowed/*
dataset/features_cache/
dataset/bins_cache/
dataset/spikes_raw_*/
dataset/features_cache_*/
dataset/bins_cache_*/

!dataset/chbmit/
!dataset/spikes_raw/
!dataset/spikes_windowed/
!dataset/chbmit/README*
!dataset/spikes_raw/README*
!dataset/spikes_windowed/README*

# =========================================================
# Output data (trained models, logs, results)
# =========================================================
output_data/results/*
output_data/train_logs/*
output_data/trained_models/*

!output_data/results/
!output_data/train_logs/
!output_data/trained_models/
!output_data/results/README*
!output_data/train_logs/README*
!output_data/trained_models/README*

# =========================================================
# Analysis outputs (keep structure + READMEs)
# =========================================================
analysis/figures/*
analysis/stats/*

!analysis/figures/
!analysis/stats/
!analysis/figures/README*
!analysis/stats/README*

